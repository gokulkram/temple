# EAS Build project archive - see https://expo.fyi/eas-build-archive
# NOTE: presence of this file means .gitignore is NOT also applied, so
# everything normally gitignored needs repeating here explicitly.

node_modules/
android/
ios/

.expo/
dist/
web-build/
expo-env.d.ts

.git/
.kotlin/
*.orig.*

npm-debug.*
yarn-debug.*
yarn-error.*

.DS_Store
*.pem

.env
.env*.local

# never ship signing secrets in the build archive - credentialsSource:local
# reads these from disk locally and uploads them to EAS separately.
credentials.json
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision

*.tsbuildinfo

.metro-health-check*
