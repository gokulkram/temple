# expo-router pulls in web-devtools-only dependencies (@radix-ui/*, vaul)
# whose react-dom peer requirement (^19.2.8) doesn't match the react version
# SDK 57 pins for React Native (19.2.3). This never affects the actual app
# (those packages are web/devtools-only), but npm's strict peer resolution
# blocks on it - legacy-peer-deps skips that check, for local installs and
# for EAS Build's `npm ci` alike (both read this file).
legacy-peer-deps=true
